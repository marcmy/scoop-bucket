    "checkver": {
        "github": "https://api.github.com/repos/marcmy/RTX-Video-Tuner/commits/main",
        "script": [
            "$commit = $page | ConvertFrom-Json",
            "if ($commit.sha -notmatch '^[0-9a-f]{40}$') { throw 'Invalid commit SHA' }",
            "$date = ([DateTimeOffset]$commit.commit.committer.date).UtcDateTime.ToString('yyyyMMdd.HHmmss')",
            "\"$date $($commit.sha)\""
        ],
        "regex": "^(?<version>\\d{8}\\.\\d{6}) (?<sha>[0-9a-f]{40})$"
    },
    "autoupdate": {
        "url": "https://github.com/marcmy/RTX-Video-Tuner/archive/$matchSha.zip",
        "extract_dir": "RTX-Video-Tuner-$matchSha"
    }
