{
    "version": "2026.10.03",
    "description": "USB mouse and controller polling rate overclocking utility for Windows.",
    "homepage": "https://github.com/LordOfMice/hidusbf",
    "license": {
        "identifier": "Unknown",
        "url": "https://github.com/LordOfMice/hidusbf"
    },
    "url": "https://raw.githubusercontent.com/LordOfMice/hidusbf/master/hidusbf.zip",
    "hash": "f895c5935c6363afa00b20557b6096cef2b29daa97c1b399dceb85e5af855229",
    "notes": [
        "HIDUSBF is installed into Scoop's usual app directory.",
        "A Start Menu shortcut (Scoop Apps\\HIDUSBF Setup) points to DRIVER\\Setup.exe.",
        "Recent Windows versions may require disabling Memory Integrity before the driver can be installed."
    ],
    "shortcuts": [
        [
            "DRIVER\\Setup.exe",
            "HIDUSBF Setup"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/LordOfMice/hidusbf/commits?path=hidusbf.zip&sha=master&per_page=1",
        "jsonpath": "$[0].commit.committer.date",
        "regex": "^(\\d{4})-(\\d{2})-(\\d{2})T",
        "replace": "$1.$2.$3"
    },
    "autoupdate": {
        "url": "https://raw.githubusercontent.com/LordOfMice/hidusbf/master/hidusbf.zip"
    },
    "post_install": [
        "$setup = Join-Path $dir 'DRIVER\\Setup.exe'",
        "if (!(Test-Path $setup)) {",
        "  Write-Host ('Expected Setup.exe was not found at: {0}' -f $setup) -ForegroundColor Yellow",
        "}"
    ]
}
