{
    "version": "0.11.1",
    "description": "GPU-accelerated mosaic restoration tool for modern NVIDIA GPUs.",
    "homepage": "https://github.com/Kruk2/jasna",
    "license": "AGPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/Kruk2/jasna/releases/download/v0.11.1/jasna-windows-0.11.1.7z.001",
                "https://github.com/Kruk2/jasna/releases/download/v0.11.1/jasna-windows-0.11.1.7z.002",
                "https://github.com/Kruk2/jasna/releases/download/v0.11.1/jasna-windows-0.11.1.7z.003"
            ],
            "hash": [
                "d3e7bbab56700a9f3553c9c401cf1d5f571dd547a60273566b9a3aa783f02921",
                "1a8e4ca977cce8c4bee29848ee0c0f43d8b554d2c04bd7a5a19665a39785895a",
                "8b5643c7159ea1c84cc3eb2f9a856a800b6026793ec16b7bdbc3047e79be1380"
            ]
        }
    },
    "pre_install": [
        "$ErrorActionPreference = 'Stop'",
        "$exe = Join-Path $dir 'jasna.exe'",
        "$nested = Join-Path $dir 'dist_windows'",
        "if (!(Test-Path $exe) -and (Test-Path (Join-Path $nested 'jasna.exe'))) {",
        "    Get-ChildItem $nested -Force | Move-Item -Destination $dir -Force",
        "    Remove-Item $nested -Recurse -Force -ErrorAction SilentlyContinue",
        "}",
        "if (!(Test-Path $exe)) { throw 'jasna.exe was not found after extraction.' }"
    ],
    "bin": [
        [
            "jasna.exe",
            "jasna"
        ]
    ],
    "shortcuts": [
        [
            "jasna.exe",
            "Jasna"
        ]
    ],
    "persist": "model_weights",
    "notes": [
        "This is a large split 7-Zip release. Scoop extracts the .001 part after all chunks are downloaded and verified.",
        "Jasna requires a modern NVIDIA GPU and current NVIDIA drivers. First run compiles TensorRT engines and can take a while.",
        "model_weights is persisted so compiled engines survive updates.",
        "Jasna settings are stored by the app under $env:APPDATA\\jasna, outside Scoop's install dir, so they are not managed by this manifest."
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Kruk2/jasna/releases/latest",
        "script": "$page",
        "regex": "\"tag_name\"\\s*:\\s*\"(?<tag>v?(?<version>[^\"]+))\"[\\s\\S]*?\"name\"\\s*:\\s*\"(?<asset>(?![^\"]*amd)[^\"]*windows[^\"]*\\.7z)\\.001\"",
        "replace": "${version}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/Kruk2/jasna/releases/download/$matchTag/$matchAsset.001",
                    "https://github.com/Kruk2/jasna/releases/download/$matchTag/$matchAsset.002",
                    "https://github.com/Kruk2/jasna/releases/download/$matchTag/$matchAsset.003"
                ],
                "hash": [
                    {
                        "mode": "json",
                        "url": "https://api.github.com/repos/Kruk2/jasna/releases/tags/$matchTag",
                        "jsonpath": "$.assets[?(@.name=='$basename')].digest",
                        "regex": "sha256:([a-f0-9]{64})"
                    },
                    {
                        "mode": "json",
                        "url": "https://api.github.com/repos/Kruk2/jasna/releases/tags/$matchTag",
                        "jsonpath": "$.assets[?(@.name=='$basename')].digest",
                        "regex": "sha256:([a-f0-9]{64})"
                    },
                    {
                        "mode": "json",
                        "url": "https://api.github.com/repos/Kruk2/jasna/releases/tags/$matchTag",
                        "jsonpath": "$.assets[?(@.name=='$basename')].digest",
                        "regex": "sha256:([a-f0-9]{64})"
                    }
                ]
            }
        }
    }
}
