{
    "version": "20260914.0652",
    "description": "Tray app that automatically adjusts Razer HyperPolling dongle polling rate based on foreground or running processes.",
    "homepage": "https://github.com/marcmy/RazerAutoPollingRate",
    "license": "ISC",
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/marcmy/RazerAutoPollingRate/actions/runs/34815022017/RazerAutoPollingRate-Scoop-main-b278ac4b5bffc556bdf51c2f6d3b291ff3b4eea0.zip",
            "hash": "78f728d669a007011ef513f25f6a27fb355db8f2fff9da6f1967a50191141488"
        }
    },
    "extract_dir": "lib/net45",
    "shortcuts": [
        [
            "razerautopollingrate.exe",
            "Razer Auto Polling Rate"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/marcmy/RazerAutoPollingRate/actions/artifacts?per_page=100",
        "script": [
            "$repoId = 1230978983",
            "$namePattern = '^RazerAutoPollingRate-Scoop-main-[0-9a-f]{40}$'",
            "$response = $page | ConvertFrom-Json",
            "$artifact = ($response.artifacts | Where-Object {",
            "    ($_.name -match $namePattern) -and",
            "    (-not $_.expired) -and",
            "    ($_.workflow_run.head_repository_id -eq $repoId) -and",
            "    ($_.workflow_run.head_branch -eq 'main')",
            "} | Sort-Object created_at -Descending | Select-Object -First 1)",
            "if (-not $artifact) { throw 'No matching non-expired marcmy/RazerAutoPollingRate main Scoop artifacts found' }",
            "$rollingVersion = ([DateTimeOffset]$artifact.created_at).UtcDateTime.ToString('yyyyMMdd.HHmm')",
            "\"{0} {1} {2}\" -f $rollingVersion, $artifact.workflow_run.id, $artifact.name"
        ],
        "regex": "^(?<version>\\d{8}\\.\\d{4}) (?<run>\\d+) (?<artifact>.+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/marcmy/RazerAutoPollingRate/actions/runs/$matchRun/$matchArtifact.zip"
            }
        }
    }
}
