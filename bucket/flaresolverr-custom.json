{
    "version": "39130835028",
    "description": "Custom FlareSolverr build automatically tracking FlareSolverr/FlareSolverr upstream master.",
    "homepage": "https://github.com/marcmy/FlareSolverr",
    "license": "MIT",
    "url": "https://nightly.link/marcmy/FlareSolverr/actions/runs/39130835028/FlareSolverr-Custom_Windows-x64-9845951a9416.zip",
    "hash": "b303bc04172221570486cb8a15269ed554c2976fc8ee82b8ff3c25e8cb6950bd",
    "extract_dir": "flaresolverr",
    "bin": "flaresolverr.exe",
    "checkver": {
        "github": "https://api.github.com/repos/marcmy/FlareSolverr/actions/artifacts?per_page=100",
        "script": [
            "$repoId = 1366568088",
            "$namePattern = '^FlareSolverr-Custom_Windows-x64-[0-9a-f]{12}$'",
            "$response = $page | ConvertFrom-Json",
            "$artifact = ($response.artifacts | Where-Object {",
            "    ($_.name -match $namePattern) -and",
            "    (-not $_.expired) -and",
            "    ($_.workflow_run.head_repository_id -eq $repoId) -and",
            "    ($_.workflow_run.head_branch -eq 'master')",
            "} | Sort-Object created_at -Descending | Select-Object -First 1)",
            "if (-not $artifact) { throw 'No matching non-expired marcmy/FlareSolverr master artifacts found' }",
            "\"{0} {1}\" -f $artifact.workflow_run.id, $artifact.name"
        ],
        "regex": "^(?<version>\\d+) (?<artifact>.+)$"
    },
    "autoupdate": {
        "url": "https://nightly.link/marcmy/FlareSolverr/actions/runs/$version/$matchArtifact.zip"
    }
}
